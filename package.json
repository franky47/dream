{
  "name": "dream",
  "private": true,
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run knip",
    "clean:raw": "rm -rf data/raw",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "ingest": "bun src/ingest/main.ts",
    "knip": "knip",
    "lint": "oxlint src/",
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "errore": "^0.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "^7.0.0-dev.20260404.1",
    "knip": "^6.12.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.22.1"
  }
}
